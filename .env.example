# TradingAgents Configuration Template
# Copy this file to .env and fill in your values

# =============================================
# LLM Provider Configuration
# =============================================
# Options: openai, anthropic, google, ollama
TRADINGAGENTS_LLM_PROVIDER=ollama

# Model selection based on provider
# For Ollama (local models):
TRADINGAGENTS_DEEP_THINK_LLM=qwen3.5
TRADINGAGENTS_QUICK_THINK_LLM=qwen3.5

# For OpenAI (uncomment if using):
# TRADINGAGENTS_DEEP_THINK_LLM=gpt-4o
# TRADINGAGENTS_QUICK_THINK_LLM=gpt-4o-mini

# For Anthropic (uncomment if using):
# TRADINGAGENTS_DEEP_THINK_LLM=claude-3-5-sonnet-latest
# TRADINGAGENTS_QUICK_THINK_LLM=claude-3-5-haiku-latest

# For Google (uncomment if using):
# TRADINGAGENTS_DEEP_THINK_LLM=gemini-2.5-pro
# TRADINGAGENTS_QUICK_THINK_LLM=gemini-2.5-flash

# =============================================
# API Keys (set the one for your chosen provider)
# =============================================
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# =============================================
# Ollama Settings (only if using Ollama)
# =============================================
TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:11434

# =============================================
# Optional Settings
# =============================================
# Output language for reports
TRADINGAGENTS_OUTPUT_LANGUAGE=English

# Debate rounds (higher = more thorough but slower)
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# Checkpointing (set to true to enable resume on crash)
TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Benchmark for alpha calculation (auto-detected by ticker suffix if empty)
# TRADINGAGENTS_BENCHMARK_TICKER=SPY
